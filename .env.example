# PostgreSQL connection string from your hosting provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Generate a random secret of at least 32 characters. Never commit a real value.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Set true only when hosted behind HTTPS
COOKIE_SECURE=false
PORT=3000
# Required only for Docker Compose PostgreSQL container
POSTGRES_PASSWORD=replace-with-a-strong-database-password
